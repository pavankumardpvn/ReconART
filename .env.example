# Database
DATABASE_URL=postgresql+asyncpg://reconart:reconart_dev@localhost:5432/reconart
DATABASE_URL_SYNC=postgresql://reconart:reconart_dev@localhost:5432/reconart

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Clerk Auth
CLERK_SECRET_KEY=sk_test_your_key_here
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Storage (set to "s3" for Cloudflare R2 / S3-compatible)
STORAGE_BACKEND=local
STORAGE_PATH=./uploads

# Cloudflare R2 / S3-compatible storage (used when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# App
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-64-char-string
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
